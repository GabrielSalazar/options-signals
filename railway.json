{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "context": "."
  },
  "deploy": {
    "startCommand": "uvicorn backend.api.main:app --host 0.0.0.0 --port $PORT --workers 4",
    "numReplicas": 1,
    "restartPolicyMaxRetries": 5,
    "restartPolicyWindow": 600,
    "healthchecks": {
      "startup": {
        "path": "/health",
        "initialDelaySeconds": 10,
        "timeoutSeconds": 30,
        "periodSeconds": 60,
        "successThreshold": 1,
        "failureThreshold": 5
      }
    }
  },
  "environments": {
    "production": {
      "variables": {
        "ENVIRONMENT": "production",
        "LOG_LEVEL": "INFO"
      }
    },
    "staging": {
      "variables": {
        "ENVIRONMENT": "staging",
        "LOG_LEVEL": "DEBUG"
      }
    }
  }
}
